# Development defaults. Copy to .env and never reuse these values in production.
DATABASE_URL="postgres://postgres:pass@localhost:5432/curved"
API_PORT=3000
VITE_ZERO_CACHE_URL="http://localhost:4848"
# Better Auth. Generate a real secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="dev-only-secret-change-me-in-production"
# The web app's URL. Vite proxies /api to the API in development.
BETTER_AUTH_URL="http://localhost:5173"
# Optional: AUTH_OPEN_SIGN_UP, AUTH_COOKIE_DOMAIN, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SMTP_URL and
# SMTP_FROM. See apps/api/src/env.ts.
