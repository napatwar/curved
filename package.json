{
  "name": "curved",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:web": "vitest run --project web",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "test:spike": "playwright test -c playwright.spike.config.ts",
    "spike:clients": "tsx --env-file-if-exists=.env e2e/spike/concurrent-clients.ts",
    "spike:rebuild": "tsx e2e/spike/rebuild-replica.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "infra:up": "docker compose up -d --wait postgres && pnpm db:migrate && pnpm db:seed && docker compose up -d --wait zero-cache",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @curved/db generate",
    "db:migrate": "pnpm --filter @curved/db migrate",
    "db:seed": "pnpm --filter @curved/db seed",
    "db:seed:spike": "pnpm --filter @curved/db seed:spike",
    "zero:generate": "pnpm --filter @curved/zero generate"
  },
  "devDependencies": {
    "@curved/db": "workspace:*",
    "@curved/zero": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@rocicorp/zero": "1.11.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/browser-playwright": "^5.1.0",
    "drizzle-orm": "^0.45.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
