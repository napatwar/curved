# Curved self-hosting settings. See docs/self-hosting.md.
#
#   cp .env.example .env && chmod 600 .env
#
# Generate each secret with:  openssl rand -hex 32
# (hex, because the Postgres password goes inside a connection URL)

# --- Address -----------------------------------------------------------------

# The host name people use to open Curved, without https://.
CURVED_DOMAIN=localhost

# How Caddy serves CURVED_DOMAIN. Leave it empty to get a Let's Encrypt
# certificate for CURVED_DOMAIN (ports 80 and 443 must be reachable from the
# internet). Use http://<host> on your own machine (http://localhost), or when
# Tailscale Serve or Cloudflare Tunnel handles HTTPS in front of Caddy.
CADDY_SITE_ADDRESS=http://localhost

# The full address people open, with http:// or https://. Sign-in accepts
# requests only from this address. Use https:// whenever HTTPS is in front,
# including Tailscale Serve and Cloudflare Tunnel.
BETTER_AUTH_URL=http://localhost

# Host ports Caddy listens on.
HTTP_PORT=80
HTTPS_PORT=443

# --- Secrets (required) ------------------------------------------------------

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
ZERO_ADMIN_PASSWORD=

# --- Backups -----------------------------------------------------------------

# Daily pg_dump into ./backups at this time, in the TZ time zone.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=7
TZ=UTC

# --- zero-cache --------------------------------------------------------------

# Defaults suit a small machine with a few users.
ZERO_NUM_SYNC_WORKERS=2
ZERO_MEMORY_LIMIT=2g
# Set to true to send Rocicorp anonymous usage data and help improve Zero.
ZERO_ENABLE_TELEMETRY=false
# Stops a stopped zero-cache from filling the disk with Postgres WAL.
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=10GB

# --- Sign-in (optional) ------------------------------------------------------

# The first person to sign up becomes the instance admin, then sign-up closes
# and people join by invitation. Set to true to let anyone sign up.
# AUTH_OPEN_SIGN_UP=false
# Email for invitations, email verification and password reset, such as
# smtps://user:password@smtp.example.com:465
# SMTP_URL=
# SMTP_FROM=Curved <curved@example.com>
# Google and GitHub sign-in stay off unless both values are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Optional ----------------------------------------------------------------

# debug, info, warn or error
LOG_LEVEL=info
# Error tracking with Sentry, or a compatible service such as GlitchTip or Bugsink.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# zero-cache metrics to your OpenTelemetry collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=
