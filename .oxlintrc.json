{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/*.gen.ts",
    "packages/db/migrations/**",
    "apps/web/src/components/ui/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/consistent-type-imports": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-default-export": "error",
    "import/no-cycle": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.config.ts", "**/drizzle.config.ts", "e2e/**/global-setup.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["apps/web/src/routes/**"],
      "rules": {
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": [
        "apps/api/src/index.ts",
        "apps/api/src/cli/**",
        "packages/db/src/seed.ts",
        "packages/db/src/seed-spike.ts",
        "e2e/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "plugins": ["vitest"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@curved/db",
                "message": "The web app must not import database code. Use @curved/db/constants."
              },
              {
                "name": "@curved/db/schema",
                "message": "The web app must not import database code. Use @curved/db/constants."
              }
            ],
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import another feature through its index file."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@curved/web", "@curved/api"],
                "message": "Packages must not import apps."
              }
            ]
          }
        ]
      }
    }
  ]
}
